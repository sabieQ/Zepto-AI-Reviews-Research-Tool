# --- Required ---
# Prefer Supabase *session* pooler (port 5432), not transaction pooler (6543).
# URL-encode special chars in the password (@ → %40).
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Exact browser origin(s) for CORS — comma-separated if you have preview + prod.
# Local: http://localhost:3000
# Prod:  https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=INFO
UPLOAD_DIR=./uploads

# AI — required for Index + Research (never expose to the frontend)
# https://openrouter.ai/keys
AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Embeddings: remote (OpenRouter — costs) or local (free on-device via fastembed)
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional collectors (defaults match Zepto consumer apps)
# COLLECTOR_PLAY_APP_ID=com.zeptoconsumerapp
# COLLECTOR_IOS_APP_ID=1575323645
# COLLECTOR_COUNTRY=in
# COLLECTOR_LANG=en
# COLLECTOR_MAX_PER_STORE=100
# COLLECTOR_MASTER_DATASET_NAME=Zepto Public Mentions

# Docker / Render: prompts live at /prompts (set automatically in Dockerfile)
# PROMPTS_DIR=/prompts
